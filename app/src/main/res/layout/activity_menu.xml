<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/buttonStart"
        android:layout_width="160dp"
        android:layout_height="0dp"
        android:layout_marginBottom="43dp"
        android:backgroundTint="#E91E63"
        android:text="@string/start"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/buttonProfile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textMenu" />

    <Button
        android:id="@+id/buttonProfile"
        android:layout_width="160dp"
        android:layout_height="0dp"
        android:layout_marginBottom="46dp"
        android:text="@string/profile"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/buttonSettings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonStart" />

    <Button
        android:id="@+id/buttonSettings"
        android:layout_width="160dp"
        android:layout_height="0dp"
        android:layout_marginBottom="222dp"
        android:text="@string/settings"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/buttonReport"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonProfile" />

    <TextView
        android:id="@+id/textMenu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="58dp"
        android:layout_marginTop="123dp"
        android:layout_marginEnd="58dp"
        android:layout_marginBottom="89dp"
        android:fontFamily="sans-serif-black"
        android:text="@string/menu"
        android:textAlignment="center"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/buttonStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/buttonReport"
        android:layout_width="160dp"
        android:layout_height="0dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#A6A5A5"
        android:text="@string/report"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/buttonExitFromMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonSettings" />

    <Button
        android:id="@+id/buttonExitFromMenu"
        android:layout_width="160dp"
        android:layout_height="0dp"
        android:layout_marginBottom="60dp"
        android:backgroundTint="#A6A5A5"
        android:text="@string/exit"
        android:textSize="20sp"
        app:iconTint="#A6A5A5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonReport" />

</androidx.constraintlayout.widget.ConstraintLayout>